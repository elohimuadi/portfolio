---
// Phaser is initialized client-side from the script block below.
// The Astro server pass renders the canvas mount + the dialogue shell.
---

<div id="game-root" class="game-root" aria-label="GOL interactive map"></div>

<div id="portfolio-dialogue" class="dialogue-layer" hidden>
  <div
    class="dialogue"
    role="dialog"
    aria-modal="true"
    aria-labelledby="dialogue-title"
    aria-describedby="dialogue-body-text"
    data-dialogue
  >
    <div class="dialogue-title-box" id="dialogue-title" data-dialogue-title>—</div>
    <div class="dialogue-body-box">
      <p class="dialogue-text" id="dialogue-body-text" data-dialogue-text></p>
      <span class="dialogue-advance" aria-hidden="true" data-dialogue-advance></span>
    </div>
  </div>
</div>

<style>
  .game-root {
    width: 100vw;
    height: 100vh;
    background: #f6f4ee;
    image-rendering: pixelated;
    overflow: hidden;
  }

  .game-root :global(canvas) {
    image-rendering: pixelated;
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  /* Full-viewport overlay that captures clicks for "advance dialogue" but
     leaves the world visible behind it (no backdrop dim). */
  .dialogue-layer {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0 16px 20px;
    cursor: pointer;
  }

  .dialogue-layer[hidden] {
    display: none;
  }

  .dialogue {
    width: min(880px, 100%);
    color: #000000;
    /* Plain 'monospace' — the exact font-family string BootScene/IntroScene
       use for their Phaser text (fontFamily: 'monospace'), so the DOM
       dialogue and the Phaser boot/intro screens read as the same font. */
    font-family: monospace;
    animation: dialogue-in 180ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* Both boxes are Josh's drawings, 9-sliced with border-image so they
     stretch to any size; `fill` paints the drawing's white inside too. The
     script swaps --box-img every 125ms for the boil. */
  .dialogue-title-box {
    display: inline-block;
    border: 12px solid transparent;
    border-image-source: var(--box-img);
    border-image-slice: 40 fill; /* TITLEBOX_SLICE */
    border-image-width: 20px;
    border-image-repeat: stretch;
    padding: 10px 16px 4px;
    margin-left: 18px;
    margin-bottom: -16px; /* tuck the tab over the body box's top line */
    font-size: 16px;
    line-height: 1.5;
    position: relative;
    z-index: 1;
  }

  .dialogue-body-box {
    position: relative;
    border: 30px solid transparent;
    border-image-source: var(--box-img);
    border-image-slice: 80 fill; /* TEXTBOX_SLICE */
    border-image-width: 40px;
    border-image-repeat: stretch;
    padding: 20px 12px 16px;
    min-height: 120px;
  }

  .dialogue-text {
    margin: 0;
    /* No font-family override — inherits monospace from .dialogue. */
    font-size: 16px;
    /* Taller than the old 1.55: the hand-drawn capitals are ~18px and
       descenders need room so lines don't touch. */
    line-height: 1.9;
    letter-spacing: 0.01em;
    color: #000000;
    min-height: 4.5em;
    white-space: pre-wrap;
  }

  /* ---- Hand-drawn font (see src/game/handfont.ts) ----------------------
     Glyphs are built at runtime, so these rules are :global. Each .hg is a
     zero-height inline box sitting on the baseline; its ::before carries the
     sprite strip as a mask, filled with currentColor. --hand-cell and
     --hand-baseline are set on the text element from the generated metrics. */
  .dialogue :global(.hw) {
    display: inline-block;
    white-space: nowrap;
  }

  .dialogue :global(.hs) {
    display: inline-block;
  }

  .dialogue :global(.hg),
  .dialogue :global(.hf) {
    visibility: hidden;
  }

  .dialogue :global(.hg.on),
  .dialogue :global(.hf.on) {
    visibility: visible;
  }

  .dialogue :global(.hg) {
    display: inline-block;
    position: relative;
    width: var(--adv);
    height: 0;
    vertical-align: baseline;
  }

  .dialogue :global(.hg)::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--lsb));
    top: calc(-1 * var(--hand-baseline));
    width: var(--cw);
    height: var(--hand-cell);
    background-color: currentColor;
    -webkit-mask-image: var(--img);
    mask-image: var(--img);
    -webkit-mask-size: calc(var(--cw) * 7) var(--hand-cell);
    mask-size: calc(var(--cw) * 7) var(--hand-cell);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: 0 0;
    mask-position: 0 0;
    animation: hand-boil 625ms steps(5, end) infinite;
    animation-delay: var(--delay);
  }

  /* Glitch tick: jump to one of the left-hand frames (6th or 7th). */
  .dialogue :global(.hg.glitch)::before {
    animation: none;
    -webkit-mask-position: calc(var(--cw) * var(--gf) * -1) 0;
    mask-position: calc(var(--cw) * var(--gf) * -1) 0;
  }

  /* Punctuation/digits not drawn yet: regular font, sized to sit with the
     hand-drawn letters. */
  .dialogue :global(.hf) {
    font-size: 18px;
    font-weight: 700;
  }

  .dialogue :global(.hand-sr) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @keyframes hand-boil {
    from {
      -webkit-mask-position: 0 0;
      mask-position: 0 0;
    }
    to {
      -webkit-mask-position: calc(var(--cw) * -5) 0;
      mask-position: calc(var(--cw) * -5) 0;
    }
  }

  /* Squiggle in the corner: grows while the line types, then loops the
     finished squiggles in place of the old ▼. Frame set by the script via
     --sq-frame; the strip is SQUIGGLE in src/game/ui-art.ts. */
  .dialogue-advance {
    position: absolute;
    /* Sits inside the drawn outline, clear of its wobbly bottom-right edge. */
    right: 16px;
    bottom: 6px;
    width: 28px;
    height: 25px;
    background-image: url('/assets/ui/squiggle.png');
    background-repeat: no-repeat;
    background-size: calc(28px * 35) 25px;
    background-position: calc(-28px * var(--sq-frame, 0)) 0;
    pointer-events: none;
    visibility: hidden;
  }

  .dialogue[data-state='typing'] .dialogue-advance,
  .dialogue[data-state='ready'] .dialogue-advance {
    visibility: visible;
  }

  @keyframes dialogue-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dialogue {
      animation: none;
    }
    .dialogue :global(.hg)::before {
      animation: none;
    }
  }
</style>

<script>
  import { startGame } from '../game/main';
  import {
    EVT_CHOICE_CONFIRMED,
    EVT_HIDE_CHOICES,
    EVT_INTERACT,
    EVT_MODAL_CLOSED,
    EVT_NPC_REACT,
    EVT_SHOW_CHOICES,
    interactionState,
    type ChoiceConfirmedDetail,
    type InteractDetail,
    type NpcReactDetail,
  } from '../game/state';
  import { INTERACTABLE_CONTENT, type DialogueChoice } from '../game/content/interactables';
  import { DIALOGUE_SFX_KEY } from '../game/scenes/BootScene';
  import { HANDFONT } from '../game/content/handfont-metrics';
  import { preloadHandFont, renderHandText, revealHand, startHandGlitches } from '../game/handfont';
  import {
    BOX_FRAME_MS,
    SQUIGGLE,
    TEXTBOX_FRAMES,
    TITLEBOX_FRAMES,
    UI_FRAME_MS,
    textboxUrl,
    titleboxUrl,
  } from '../game/ui-art';

  const TYPE_SPEED_MS = 35;
  const DIALOGUE_SFX_VOLUME = 0.35;
  const DIALOGUE_SFX_MIN_RATE = 0.9;
  const DIALOGUE_SFX_MAX_RATE = 1.1;

  const game = startGame('game-root');
  // Phaser's SoundManager lives on the Game instance itself (the same object
  // every Scene's `this.sound` points to), so this DOM-side typewriter can
  // share BootScene's preloaded clip without needing its own Scene. Built
  // lazily (not here at module scope) because BootScene's preload — which
  // decodes dialogue.wav into the audio cache — hasn't run yet at this point;
  // Phaser.Sound's `add()` throws synchronously if the key isn't cached yet,
  // and an uncaught throw here would abort the rest of this module, silently
  // skipping every listener registered below it (including EVT_INTERACT).
  let typeSfx: Phaser.Sound.BaseSound | null = null;

  // Stopping before re-playing (rather than letting each call overlap the
  // last) is what gives the clipped, staccato "RPG chatter" sound instead of
  // a blurred wall of overlapping tones.
  function playTypeSfx(): void {
    if (!typeSfx) {
      if (!game.cache.audio.exists(DIALOGUE_SFX_KEY)) return;
      typeSfx = game.sound.add(DIALOGUE_SFX_KEY, { volume: DIALOGUE_SFX_VOLUME });
    }
    typeSfx.stop();
    const rate = DIALOGUE_SFX_MIN_RATE + Math.random() * (DIALOGUE_SFX_MAX_RATE - DIALOGUE_SFX_MIN_RATE);
    typeSfx.play({ rate });
  }

  const layer = document.getElementById('portfolio-dialogue');
  if (!layer) throw new Error('Dialogue mount missing.');

  const dialogueEl = layer.querySelector<HTMLElement>('[data-dialogue]');
  const titleEl = layer.querySelector<HTMLElement>('[data-dialogue-title]');
  const textEl = layer.querySelector<HTMLElement>('[data-dialogue-text]');
  const bodyBoxEl = layer.querySelector<HTMLElement>('.dialogue-body-box');
  const advanceEl = layer.querySelector<HTMLElement>('[data-dialogue-advance]');
  if (!dialogueEl || !titleEl || !textEl || !bodyBoxEl || !advanceEl) {
    throw new Error('Dialogue template missing required slots.');
  }

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Set on the whole dialogue so both the title and the body pick them up.
  dialogueEl.style.setProperty('--hand-cell', `${HANDFONT.cellHeight}px`);
  dialogueEl.style.setProperty('--hand-baseline', `${HANDFONT.baseline}px`);
  preloadHandFont();
  startHandGlitches(dialogueEl);

  // ---- Hand-drawn boxes + squiggle ------------------------------------
  // Preload every box frame so the boil never shows a half-loaded image.
  // Kept in an array: an unreferenced Image can be collected mid-download.
  const uiPreload: HTMLImageElement[] = [];
  const preloadUi = (src: string) => {
    const img = new Image();
    img.src = src;
    uiPreload.push(img);
  };
  for (let i = 0; i < TEXTBOX_FRAMES; i++) preloadUi(textboxUrl(i));
  for (let i = 0; i < TITLEBOX_FRAMES; i++) preloadUi(titleboxUrl(i));
  preloadUi(SQUIGGLE.url);

  let uiTick = 0;
  let squiggleMode: 'growing' | 'looping' = 'growing';
  function setSquiggleFrame(frame: number): void {
    advanceEl.style.setProperty('--sq-frame', String(frame));
  }
  const BOX_EVERY = Math.round(BOX_FRAME_MS / UI_FRAME_MS); // ticks per box frame
  function drawBoxes(): void {
    const boxTick = Math.floor(uiTick / BOX_EVERY);
    bodyBoxEl.style.setProperty('--box-img', `url("${textboxUrl(boxTick % TEXTBOX_FRAMES)}")`);
    // Offset so the tab and the body don't change drawing on the same beat.
    titleEl.style.setProperty('--box-img', `url("${titleboxUrl((boxTick + 3) % TITLEBOX_FRAMES)}")`);
  }
  drawBoxes();
  setSquiggleFrame(0);
  if (!prefersReducedMotion) {
    window.setInterval(() => {
      if (layer.hidden) return;
      uiTick += 1;
      drawBoxes();
      if (squiggleMode === 'looping') {
        setSquiggleFrame(SQUIGGLE.growth + (uiTick % SQUIGGLE.complete));
      }
    }, UI_FRAME_MS);
  }

  // Squiggle draws itself in as the line types: progress 0..1 -> growth frame.
  function growSquiggle(progress: number): void {
    squiggleMode = 'growing';
    setSquiggleFrame(Math.min(SQUIGGLE.growth - 1, Math.floor(progress * SQUIGGLE.growth)));
  }
  function loopSquiggle(): void {
    squiggleMode = 'looping';
    setSquiggleFrame(SQUIGGLE.growth);
  }

  let fullText = '';
  // One element per character of fullText (see renderHandText); the
  // typewriter reveals them in order instead of re-setting textContent.
  let handUnits: HTMLElement[] = [];
  let typedIndex = 0;
  let typingTimer: number | null = null;
  let isTyping = false;
  // Choices to show once the current line finishes typing, and the ones
  // currently active (i.e. already handed off to WorldScene's Phaser choice
  // UI via EVT_SHOW_CHOICES). Cleared after the player picks one, so a
  // chosen follow-up line (e.g. "Alright, next time then.") always ends in
  // the plain 'ready' state instead of re-prompting.
  let pendingChoices: DialogueChoice[] | null = null;
  let activeChoices: DialogueChoice[] | null = null;
  // The interactable currently open in the dialogue box, so a chosen
  // reaction (see EVT_NPC_REACT) knows which NPC it's for.
  let currentInteractableId: string | null = null;

  function clearTimer(): void {
    if (typingTimer !== null) {
      window.clearInterval(typingTimer);
      typingTimer = null;
    }
  }

  function setState(state: 'typing' | 'ready' | 'choosing' | 'closed'): void {
    if (state === 'closed') {
      dialogueEl.removeAttribute('data-state');
    } else {
      dialogueEl.setAttribute('data-state', state);
    }
  }

  function showChoices(choices: DialogueChoice[]): void {
    activeChoices = choices;
    interactionState.choicesOpen = true;
    window.dispatchEvent(
      new CustomEvent(EVT_SHOW_CHOICES, { detail: { labels: choices.map((c) => c.label) } })
    );
  }

  function hideChoices(): void {
    if (!interactionState.choicesOpen) return;
    activeChoices = null;
    interactionState.choicesOpen = false;
    window.dispatchEvent(new CustomEvent(EVT_HIDE_CHOICES));
  }

  function selectChoice(index: number): void {
    const choice = activeChoices?.[index];
    if (!choice) return;

    hideChoices();

    if (choice.reaction && currentInteractableId) {
      window.dispatchEvent(
        new CustomEvent<NpcReactDetail>(EVT_NPC_REACT, {
          detail: { id: currentInteractableId, reaction: choice.reaction },
        })
      );
    }

    if (choice.href) {
      window.open(choice.href, '_blank', 'noopener,noreferrer');
    }

    if (choice.followUpBody) {
      pendingChoices = choice.followUpChoices ?? null;
      fullText = choice.followUpBody;
      startTyping();
      return;
    }

    closeDialogue();
  }

  function finishTyping(): void {
    clearTimer();
    revealHand(handUnits, handUnits.length);
    isTyping = false;
    if (pendingChoices && pendingChoices.length > 0) {
      // Squiggle hides while the choice box is up (CSS shows it only in
      // typing/ready).
      setState('choosing');
      showChoices(pendingChoices);
    } else {
      setState('ready');
      loopSquiggle();
    }
  }

  function startTyping(): void {
    clearTimer();
    typedIndex = 0;
    handUnits = renderHandText(textEl, fullText);
    isTyping = true;
    setState('typing');
    growSquiggle(0);

    if (prefersReducedMotion) {
      finishTyping();
      return;
    }

    typingTimer = window.setInterval(() => {
      typedIndex += 1;
      handUnits[typedIndex - 1]?.classList.add('on');
      growSquiggle(typedIndex / Math.max(1, fullText.length));
      playTypeSfx();
      if (typedIndex >= fullText.length) {
        finishTyping();
      }
    }, TYPE_SPEED_MS);
  }

  // Session count deliberately survives closing/reopening the dialogue.
  let trashcanInteractions = 0;

  function openDialogue(id: string): void {
    const content = INTERACTABLE_CONTENT[id];
    if (!content) return;

    pendingChoices = content.choices ?? null;
    hideChoices();
    fullText = content.body;
    if (id === 'trashcan') {
      trashcanInteractions += 1;
      if (trashcanInteractions < 3) {
        fullText = trashcanInteractions === 1
          ? 'its just a normal trash can'
          : 'its just a normal trash can\n...or is it?';
        pendingChoices = null;
      }
      window.dispatchEvent(new CustomEvent<NpcReactDetail>(EVT_NPC_REACT, {
        detail: { id, reaction: trashcanInteractions >= 3 ? 'reveal' : 'hide' },
      }));
    }
    // Title is shown in full right away (no typewriter), uppercased the way
    // the old text-transform did it, since CSS can't uppercase mask glyphs.
    revealHand(renderHandText(titleEl, content.title.toUpperCase()), Infinity);
    currentInteractableId = id;

    layer.hidden = false;
    interactionState.modalOpen = true;

    startTyping();
  }

  function closeDialogue(): void {
    if (!interactionState.modalOpen) return;
    clearTimer();
    isTyping = false;
    pendingChoices = null;
    hideChoices();
    setState('closed');
    layer.hidden = true;
    interactionState.modalOpen = false;
    currentInteractableId = null;
    window.dispatchEvent(new CustomEvent(EVT_MODAL_CLOSED));
  }

  function advanceOrSkip(): void {
    if (isTyping) {
      finishTyping();
      return;
    }
    if (interactionState.choicesOpen) return;
    closeDialogue();
  }

  window.addEventListener(EVT_INTERACT, (event) => {
    const detail = (event as CustomEvent<InteractDetail>).detail;
    if (!detail?.id) return;
    openDialogue(detail.id);
  });

  // WorldScene (Phaser) owns all choice rendering/navigation now — this just
  // reacts once the player confirms one (E/Space).
  window.addEventListener(EVT_CHOICE_CONFIRMED, (event) => {
    const detail = (event as CustomEvent<ChoiceConfirmedDetail>).detail;
    if (!detail) return;
    selectChoice(detail.index);
  });

  layer.addEventListener('click', () => {
    if (!interactionState.modalOpen) return;
    advanceOrSkip();
  });

  document.addEventListener('keydown', (event) => {
    if (!interactionState.modalOpen) return;
    if (event.repeat) return;

    if (event.key === 'Escape') {
      event.preventDefault();
      closeDialogue();
      return;
    }

    // WorldScene handles W/S/arrows/E/Space entirely while choices are shown.
    if (interactionState.choicesOpen) return;

    if (event.key === 'e' || event.key === 'E' || event.key === ' ' || event.key === 'Enter') {
      event.preventDefault();
      advanceOrSkip();
    }
  });
</script>
